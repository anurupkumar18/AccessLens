{
  "schemaVersion": "1.0",
  "artifactId": "logic-gate-explorer",
  "artifactVersion": 1,
  "title": "Logic gate explorer",
  "summary": "Toggle binary inputs and observe truth-table outputs for common logic gates.",
  "subjects": [
    "electrical-engineering",
    "computer-science"
  ],
  "tags": [
    "logic",
    "gates",
    "truth-table",
    "explorer"
  ],
  "interaction": "explorer",
  "provenance": {
    "kind": "catalog",
    "sourceUrl": "https://github.com/anurupkumar18/Mind-Machine",
    "license": "CC0-1.0"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "step": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20
      }
    }
  },
  "defaultParameters": {
    "step": 0
  },
  "libraries": [],
  "accessibility": {
    "description": "Toggle binary inputs and observe truth-table outputs for common logic gates.",
    "keyboard": "Right arrow or Space advances; Left arrow goes back; Tab reaches each node.",
