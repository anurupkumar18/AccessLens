{
  "schemaVersion": "1.0",
  "artifactId": "periodic-table-explorer",
  "artifactVersion": 1,
  "title": "Periodic table explorer",
  "summary": "Select an element to see its group, period, symbol, and broad chemical category.",
  "subjects": [
    "chemistry",
    "materials-science"
  ],
  "tags": [
    "periodic-table",
    "elements",
    "explorer"
  ],
  "interaction": "explorer",
  "provenance": {
    "kind": "catalog",
    "sourceUrl": "https://github.com/anurupkumar18/Mind-Machine",
    "license": "CC0-1.0"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "step": {
        "type": "integer",
        "minimum": 0,
        "maximum": 20
      }
    }
  },
  "defaultParameters": {
    "step": 0
  },
  "libraries": [],
  "accessibility": {
    "description": "Select an element to see its group, period, symbol, and broad chemical category.",
    "keyboard": "Right arrow or Space advances; Left arrow goes back; Tab reaches each node.",
    "semanticOutline": [
      "Visual diagram",
      "Current selection",
      "Step readout"
    ]
  },
  "render": {
    "entry": "index.html",
    "minWidth": 480,
    "minHeight": 320
  }
}
