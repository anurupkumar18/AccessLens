{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactManifest",
  "description": "One interactive visualization. Retrieved catalog items, adapted items, and generated items all use this format, which is the seam that lets every stage downstream of the planner treat the three sources identically. Mirrors ArtifactManifestSchema in apps/extension/src/shared/contracts.ts; docs/VISUALIZATION_SYSTEM.md section 4.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "artifactVersion",
    "title",
    "summary",
    "subjects",
    "tags",
    "interaction",
    "provenance",
    "parameters",
    "defaultParameters",
    "libraries",
    "accessibility",
    "render"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "artifactId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "artifactVersion": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
    "subjects": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "interaction": {
      "enum": ["stepper", "explorer", "simulation", "plot", "hotspot", "timeline", "diagram"]
    },
    "provenance": {
      "description": "Where this artifact came from. Adapted requires a parent; generated requires the job that produced it.",
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "sourceUrl", "license"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "catalog" },
            "sourceUrl": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "parentArtifactId", "parentArtifactVersion", "license", "generatedBy", "jobId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "adapted" },
            "parentArtifactId": { "type": "string", "minLength": 1 },
            "parentArtifactVersion": { "type": "integer", "minimum": 1 },
            "sourceUrl": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 },
            "generatedBy": { "type": "string", "minLength": 1 },
            "jobId": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "generatedBy", "jobId"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "generated" },
            "generatedBy": { "type": "string", "minLength": 1 },
            "jobId": { "type": "string", "minLength": 1 },
            "license": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "parameters": {
      "description": "JSON Schema fragment for the instructor-settable knobs. The viewer validates instructor-set parameters against it before injecting them.",
      "type": "object",
      "required": ["type", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object", "additionalProperties": { "type": "object" } },
        "required": { "type": "array", "items": { "type": "string" } }
      }
    },
    "defaultParameters": { "type": "object" },
    "libraries": {
      "description": "Only libraries the viewer preloads into the sandbox. An artifact naming anything else fails the critic at manifest time, not at render time.",
      "type": "array",
      "items": {
        "enum": ["d3@7", "three@0.186", "cytoscape@3", "plotly-basic@2", "animejs@3", "katex@0.16", "chartjs@4"]
      }
    },
    "accessibility": {
      "description": "Charter A7: every visual has an equivalent non-visual route, so description and keyboard are required rather than optional.",
      "type": "object",
      "required": ["description", "keyboard"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "keyboard": { "type": "string", "minLength": 1, "maxLength": 600 },
        "semanticOutline": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "render": {
      "type": "object",
      "required": ["entry", "minWidth", "minHeight"],
      "additionalProperties": false,
      "properties": {
        "entry": { "const": "index.html" },
        "minWidth": { "type": "integer", "minimum": 1 },
        "minHeight": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
