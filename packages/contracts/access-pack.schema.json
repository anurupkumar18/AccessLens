{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccessPack",
  "type": "object",
  "required": ["schemaVersion", "packId", "version", "title", "assets"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assetId", "fingerprint", "title", "readingOrder", "regions"],
        "additionalProperties": false,
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "readingOrder": { "type": "array", "items": { "type": "string" } },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["regionId", "bounds", "shortDescription", "plainLanguage"],
              "additionalProperties": false,
              "properties": {
                "regionId": { "type": "string", "minLength": 1 },
                "bounds": {
                  "type": "object",
                  "required": ["x", "y", "width", "height"],
                  "additionalProperties": false,
                  "properties": {
                    "x": { "type": "number", "minimum": 0, "maximum": 1 },
                    "y": { "type": "number", "minimum": 0, "maximum": 1 },
                    "width": { "type": "number", "minimum": 0, "maximum": 1 },
                    "height": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                },
                "shortDescription": { "type": "string", "minLength": 1 },
                "plainLanguage": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
