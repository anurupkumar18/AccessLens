{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccessPack",
  "type": "object",
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "title",
    "assets"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "assetId",
          "fingerprint",
          "title",
          "readingOrder",
          "regions"
        ],
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "readingOrder": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "regionId",
                "bounds",
                "shortDescription",
                "plainLanguage"
              ],
              "additionalProperties": false,
              "properties": {
                "regionId": {
                  "type": "string",
                  "minLength": 1
                },
                "bounds": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "shortDescription": {
                  "type": "string",
                  "minLength": 1
                },
                "plainLanguage": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "mediaUri": {
            "type": "string",
            "minLength": 1
          },
          "subtitle": {
            "type": "string"
          },
          "arScene": {
            "type": "object",
            "required": [
              "modelUri",
              "defaultCamera",
              "hotspots"
            ],
            "additionalProperties": false,
            "properties": {
              "modelUri": {
                "type": "string",
                "minLength": 1
              },
              "defaultCamera": {
                "type": "string",
                "minLength": 1
              },
              "hotspots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "hotspotId",
                    "regionId",
                    "nodeName",
                    "label"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "hotspotId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "regionId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nodeName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cameraTarget": {
                      "type": "string",
                      "minLength": 1
                    },
                    "highlight": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "reviewedBy",
        "reviewedAt",
        "externalSubjectMatterReview"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        },
        "externalSubjectMatterReview": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "matching": {
      "type": "object",
      "required": [
        "algorithm",
        "hashBits",
        "maxHammingDistance",
        "minMargin",
        "onNoMatch"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "hashBits": {
          "type": "integer",
          "minimum": 1
        },
        "maxHammingDistance": {
          "type": "integer",
          "minimum": 0
        },
        "minMargin": {
          "type": "integer",
          "minimum": 0
        },
        "onNoMatch": {
          "const": "source.unmatched"
        }
      }
    },
    "arCameras": {
      "type": "object",
      "description": "Named camera framings keyed by id; each is {position, target, fov}."
    },
    "reservedReadingOrderIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
