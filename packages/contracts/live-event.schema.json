{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiveEvent",
  "description": "Per-type field matrix mirroring apps/extension/src/shared/contracts.ts LiveEventSchema. Only asset.changed and region.changed may name an asset/region; every other type -- including source.unmatched -- is base-only, so an unmatched source can never be reported alongside an invented assetId.",
  "type": "object",
  "required": ["schemaVersion", "type", "sessionId", "packId", "packVersion", "sequence", "sentAt"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "type": {
      "enum": ["session.started", "asset.changed", "region.changed", "caption.appended", "capture.paused", "capture.resumed", "capture.stopped", "source.unmatched", "session.ended"]
    },
    "sessionId": { "type": "string", "minLength": 1 },
    "packId": { "type": "string", "minLength": 1 },
    "packVersion": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 0 },
    "sentAt": { "type": "string", "format": "date-time" },
    "assetId": { "type": "string", "minLength": 1 },
    "regionId": { "type": "string", "minLength": 1 },
    "pointer": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "arState": {
      "type": "object",
      "required": ["hotspotId", "action"],
      "additionalProperties": false,
      "properties": {
        "hotspotId": { "type": "string", "minLength": 1 },
        "action": { "enum": ["focus", "highlight", "clear"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "asset.changed" } } },
      "then": {
        "required": ["assetId"],
        "properties": { "regionId": false, "pointer": false, "arState": false }
      }
    },
    {
      "if": { "properties": { "type": { "const": "region.changed" } } },
      "then": {
        "required": ["assetId", "regionId"]
      }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["session.started", "caption.appended", "capture.paused", "capture.resumed", "capture.stopped", "source.unmatched", "session.ended"] }
        }
      },
      "then": {
        "properties": { "assetId": false, "regionId": false, "pointer": false, "arState": false }
      }
    }
  ],
  "additionalProperties": false
}
