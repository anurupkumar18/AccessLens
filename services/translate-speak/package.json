{
  "name": "@accesslens/translate-speak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Translates instructor-reviewed text and speaks it with Amazon Polly.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.mjs --external:@aws-sdk/*",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@aws-sdk/client-polly": "^3.700.0",
    "@aws-sdk/client-translate": "^3.700.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
