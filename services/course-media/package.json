{
  "name": "@accesslens/course-media",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AccessLens — automatic alt text and captions for any course material a professor uploads.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:api && npm run build:finish && npm run build:worker",
    "build:api": "esbuild src/api.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/api/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:finish": "esbuild src/finish.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/finish/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --target=node22 --format=esm --outfile=worker/dist/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-transcribe": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
