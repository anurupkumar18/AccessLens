# AccessLens frozen environment-variable names (contract freeze in
# docs/PARALLEL_WORKSTREAMS.md). Part 4 (AWS live service) defines and
# deploys the real values; Parts 1-3 only need these names to exist so the
# extension build can read them via import.meta.env once Part 4 is live.
# Copy this file to .env.local and fill in real values when integrating
# against a deployed session service; the extension does not require it
# for local, network-free development.

# API Gateway WebSocket endpoint for the temporary live session service.
VITE_ACCESSLENS_WS_URL=

# HTTP API endpoint for instructor authoring requests.
VITE_ACCESSLENS_API_URL=

# CloudFront viewer URL for the static visualisation host.
VITE_ACCESSLENS_VIEWER_URL=

# HTTPS endpoint for services/ai-gateway (the AiApiUrl stack output): grounded
# "Ask this class" answers (Bedrock), reviewed-text speech (Polly), and
# instructor live captions (Transcribe). Leave empty to hide those features.
VITE_ACCESSLENS_AI_URL=

# Base URL for versioned, reviewed Access Pack assets (S3 + CloudFront).
VITE_ACCESSLENS_ASSET_BASE_URL=

# Optional, local hosting only: a published pack to show at the bare origin
# when no ?pack= is given (the installed extension leaves this unset).
VITE_ACCESSLENS_PACK_URL=

# Google sign-in for instructors (D12). The OAuth *web* client id from Google
# Cloud console, with http://localhost:5173 (and the CloudFront viewer URL)
# as authorized JavaScript origins. The same value is deployed as the API's
# accepted audience; make deploy needs GOOGLE_CLIENT_ID, the build reads
# VITE_GOOGLE_CLIENT_ID. Leave empty to hide the upload panel.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
